<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>

    <RootNamespace>DebugTools</RootNamespace>
    <AssemblyName>DebugTools</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="References\**" />
    <Compile Remove="Release\**" />
    <EmbeddedResource Remove="References\**" />
    <EmbeddedResource Remove="Release\**" />
    <None Remove="References\**" />
    <None Remove="Release\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Utils\Files\debugtools.bundle" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Utils\Files\debugtools.bundle" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>References\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>References\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>References\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="bsg.console.core">
      <HintPath>References\bsg.console.core.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Comfort">
      <HintPath>References\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="ItemComponent.Types">
      <HintPath>References\ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="spt-reflection">
      <HintPath>References\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>References\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>References\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>References\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

		<Reference Include="Unity.TextMeshPro">
			<HintPath>References\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.UI">
			<HintPath>References\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="DOTween">
			<HintPath>References\DOTween.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="DOTween.Modules">
			<HintPath>References\DOTween.Modules.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="DissonanceVoip">
			<HintPath>References\DissonanceVoip.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.AssetBundleModule">
			<HintPath>References\UnityEngine.AssetBundleModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="CommonExtensions">
			<HintPath>References\CommonExtensions.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="Sirenix.Serialization">
			<HintPath>References\Sirenix.Serialization.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="Comfort.Unity">
			<HintPath>References\Comfort.Unity.dll</HintPath>
			<Private>false</Private>
		</Reference>
</ItemGroup>

  <ItemGroup>
    <Folder Include="UI\Scripts\" />
  </ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="xcopy /Y &quot;$(TargetPath)&quot; &quot;D:\Games\SPT\Dev411\BepInEx\plugins\&quot;" />
		<Exec Command="xcopy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;D:\Games\SPT\Dev411\BepInEx\plugins\&quot;" />
	</Target>

	<Target Name="ZipReleaseBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<ReleaseDir>$(ProjectDir)Release</ReleaseDir>
			<TempStagingDir>$(IntermediateOutputPath)ZipStaging</TempStagingDir>
			<PluginTargetDir>$(TempStagingDir)\BepInEx\plugins\$(ProjectName)</PluginTargetDir>
			<ZipFilePath>$(ReleaseDir)\$(ProjectName).zip</ZipFilePath>
		</PropertyGroup>

		<RemoveDir Directories="$(TempStagingDir)" />
		<Delete Files="$(ZipFilePath)" />

		<MakeDir Directories="$(PluginTargetDir)" />
		<MakeDir Directories="$(ReleaseDir)" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginTargetDir)" />

		<Copy SourceFiles="$(ProjectDir)LICENSE.md" DestinationFolder="$(PluginTargetDir)" Condition="Exists('$(ProjectDir)LICENSE.md')" />

		<ZipDirectory SourceDirectory="$(TempStagingDir)" DestinationFile="$(ZipFilePath)" Overwrite="true" />

		<RemoveDir Directories="$(TempStagingDir)" />

		<Message Text="Successfully packaged release zip: $(ZipFilePath)" Importance="high" />
	</Target>

</Project>
